# Copy these into your environment (or your host's settings page). Never commit real values.
FLASK_SECRET_KEY=            # python -c "import secrets; print(secrets.token_hex(32))"
FLASK_DEBUG=1                # 1 only on your own computer
FLASK_HOST=0.0.0.0         # use 0.0.0.0 only behind a proper server/proxy
SESSION_COOKIE_SECURE=0      # set to 1 once the site is served over HTTPS
CURRENCY_SYMBOL=KSh
MAIL_USERNAME=you@example.com
MAIL_APP_PASSWORD=               # Gmail app password - put the real one only in your local .env
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
