# Copy this file to .env and fill it in (or set these on your host's settings page).
# Never commit the real .env - it holds passwords.

# Full list of settings with explanations: docs/OPERATIONS.md
# Lines starting with "# NAME=" are optional extras; remove the "# " to use them.

# --- Server (Docker setup, see docs/OPERATIONS.md) ---
DOMAIN=                      # e.g. shop.example.co.ke  (its DNS A record must point at the server)
POSTGRES_PASSWORD=           # letters and numbers only: python -c "import secrets; print(secrets.token_hex(24))"
# WEB_WORKERS=3              # Gunicorn worker processes (default: 2 x CPUs + 1, at most 5)
# WEB_THREADS=4              # threads per worker (default 4); keep at most about half of DB_POOL_SIZE

# --- Basics ---
FLASK_SECRET_KEY=            # required in production: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_DEBUG=0                # 1 only on your own computer, never on the live site
FLASK_HOST=127.0.0.1         # use 0.0.0.0 only behind a proper server/proxy
SESSION_COOKIE_SECURE=0      # set to 1 once the site is served over HTTPS
# TRUSTED_PROXY_COUNT=1      # proxies in front of the app (Caddy/nginx = 1; the Docker setup sets 1). 0 = none
# PUBLIC_URL=https://shop.example.co.ke   # your shop's address: used for links in emails/SMS (required when live; Docker sets it from DOMAIN)
# PORT=5000                  # only for "python app.py" (with FLASK_HOST)
SITE_NAME=ESA E-Shop
CURRENCY_SYMBOL=KSh
SHOP_TIMEZONE=Africa/Nairobi
# ALLOWED_REGISTER_EMAILS=you@example.com   # comma-separated; if set, ONLY these emails can register
# RIDER_LINK_DAYS=7          # how many days a rider delivery link works
# LOW_STOCK_THRESHOLD=5      # products with this many or fewer left show as "low stock" in the admin

# --- Database ---
# Empty = SQLite file sales.db (fine on your own computer).
# Live site: PostgreSQL, e.g. postgresql://shop:STRONG_PASSWORD@db:5432/shop
# Moving an existing SQLite shop over:  flask --app app copy-to-postgres sales.db
DATABASE_URL=
# DATABASE_PATH=sales.db     # SQLite file used when DATABASE_URL is empty (default: sales.db in the project folder)
# DB_POOL_SIZE=10            # max PostgreSQL connections per worker
# AUTO_MIGRATE=1             # 1 = upgrade the database when the app starts (the Docker setup sets 0 and migrates once in docker/entrypoint.sh)
# PROOF_FOLDER=private_uploads/proofs   # packing-proof photos/videos (private - never inside static/)

# --- Email (order confirmations, verification codes, password resets) ---
# Use your own domain for a professional sender, e.g. orders@yourshop.co.ke.
# Any SMTP provider works. Examples:
#   Gmail / Google Workspace: smtp.gmail.com, 587, TLS, app password
#   Brevo (free tier):        smtp-relay.brevo.com, 587, TLS
#   Zoho Mail:                smtp.zoho.com, 587, TLS
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_APP_PASSWORD=           # Gmail: an app password, not your normal password. Never share or commit it.
MAIL_DEFAULT_SENDER=         # e.g.  ESA E-Shop <orders@yourshop.co.ke>  (defaults to MAIL_USERNAME)

# --- SMS order updates via Africa's Talking (optional; leave empty to turn SMS off) ---
# SMS is on only when both AT_USERNAME and AT_API_KEY are set.
AT_USERNAME=                 # "sandbox" for testing (messages only reach the AT simulator), your app username when live
AT_API_KEY=
AT_SENDER_ID=                # optional approved sender name, e.g. ESASHOP

# --- M-Pesa (Daraja) ---
# Note: shop/payments.py currently calls Safaricom's SANDBOX addresses only - see docs/OPERATIONS.md.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORT_CODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=          # https://yourdomain/mpesa_callback (must be public)
MPESA_CALLBACK_ALLOWED_IPS=  # optional: Safaricom's callback IPs from the Daraja docs, comma-separated

# --- Security & monitoring ---
REQUIRE_ADMIN_2FA=0          # 1 = admins must turn on two-step login (the Docker setup sets 1)
SENTRY_DSN=                  # optional: error reports from https://sentry.io (free plan available)

# Shop contact details (phone, WhatsApp, address, hours, social links) are set
# in Admin -> Shop settings, not here.
